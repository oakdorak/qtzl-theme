<!-- layout/theme.liquid -->
<!DOCTYPE html>
<html {{ html_attributes }}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}" media="all">
  {% render 'head' %}
</head>
<body {{ body_attributes }}>
  {{ content_for_layout }}
  {% render 'footer' %}
</body>
</html>