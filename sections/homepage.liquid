<!-- sections/homepage.liquid -->
<div class="qtzl-hub" style="--bg:#231f24; color:var(--qtzl-cream); max-width:960px; margin:0 auto; padding:4rem 1.5rem;">
  <div class="qtzl-mark" style="text-align:center; margin:0 auto 2rem;">
    <div class="qtzl-mark__emblem" style="font-size:32px; line-height:1; color:var(--qtzl-gold);">🔱</div>
    <div class="qtzl-mark__tag" style="letter-spacing:0.42em; text-transform:uppercase; font-size:10px; color:var(--qtzl-teal);">Serpiente Emplumada</div>
  </div>
  <h1 style="color:var(--qtzl-cream); font-size:28px; font-weight:700; text-align:center; margin-bottom:1rem;">Quetzalcoatl</h1>
  <p style="color:var(--qtzl-muted); font-size:14px; line-height:1.6; text-align:center; max-width:60ch;">Portal soberano del ecosistema Qtzl. Un solo mundo y sus puertas — para los que comparten el vuelo del mesh.</div>
  <div class="qtzl-grid" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:1.5rem; margin-top:2rem;">
    <a class="qtzl-card" href="https://beta-sovereign-2015.tail22de7d.ts.net" style="background:var(--qtzl-panel); border:1px solid var(--qtzl-border); border-radius:10px; padding:1rem; text-decoration:none; color:inherit; display:block;">
      <span class="qtzl-badge qtzl-badge--owner" style="position:absolute; top:8px; right:8px; font-size:9px; letter-spacing:0.08em; text-transform:uppercase; padding:3px 6px; border-radius:999px;">Owner</span>
      <span class="qtzl-card__title" style="font-size:15px; font-weight:700; color:var(--qtzl-cream);">Cielo (Hub Soberano)</span>
      <span class="qtzl-card__desc" style="font-size:12px; color:var(--qtzl-muted);">Ruta de entrada al mesh nativo por Tailscale. Nodos, código y calendario.</span>
    </a>
    <a class="qtzl-card" href="https://music.qtzl.cloud" style="background:var(--qtzl-panel); border:1px solid var(--qtzl-border); border-radius:10px; padding:1rem; text-decoration:none; color:inherit; display:block;">
      <span class="qtzl-badge qtzl-badge--base">Base</span>
      <span class="qtzl-card__title" style="font-size:15px; font-weight:700; color:var(--qtzl-cream);">Música (Navidrome)</span>
      <span class="qtzl-card__desc" style="font-size:12px; color:var(--qtzl-muted);">Tu biblioteca soberana, streaming propio sin intermediarios.</span>
    </a>
    <a class="qtzl-card" href="https://ai.qtzl.cloud" rel="noopener">
      <span class="qtzl-badge qtzl-badge--base">Base</span>
      <span class="qtzl-card__title" style="font-size:15px; font-weight:700; color:var(--qtzl-cream);">Eureka / IA del mesh</span>
      <span class="qtzl-card__desc" style="font-size:12px; color:var(--qtzl-muted);">Gateway de inferencia sobre tu flota.</span>
    </a>
  </div>
</div>